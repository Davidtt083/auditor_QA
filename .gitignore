cache_definiciones.json
*.log
instance/
.pytest_cache/

# Documentos PDF generados en pruebas locales
*.pdf

# =====================================================================
# SISTEMA OPERATIVO Y SERVICIOS EN LA NUBE (Windows, OneDrive, macOS)
# =====================================================================
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini

# OneDrive y archivos de sincronización
~$*
*.tmp

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

